    "text_0008": "About",
    "text_0009": "Contact",
    "text_0010": "Log In",
    "text_0011": "Instructions for White Listing Emails ",
    "text_0012": "For Gmail:",
    "text_0013": "Open Gmail and log in.",
    "text_0014": "Click the \"Settings\" gear icon in the upper-right corner.",
    "text_0015": "Select \"See all settings.\"",
    "text_0016": "Navigate to the \"Filters and Blocked Addresses\" tab.",
    "text_0017": "Click \"Create a new filter.\"",
    "text_0018": "In the \"From\" field, enter our email address ([Your Email Address]).",
    "text_0019": "Click \"Create filter.\"",
    "text_0020": "Check the box \"Never send it to Spam.\"",
    "text_0021": "Click \"Create filter.\"",
    "text_0022": "For Yahoo Mail:",
    "text_0023": "Log in to Yahoo Mail.",
    "text_0024": "Click the \"Settings\" gear icon.",
    "text_0025": "Select \"More Settings\" at the bottom of the list.",
    "text_0026": "Click \"Filters\" in the left menu.",
    "text_0027": "Click \"Add new filters.\"",
    "text_0028": "Give your filter a name (e.g., \"Whitelist [Your Company]\").",
    "text_0029": "In the \"Set rules\" section, choose \"From\" in the first dropdown.",
    "text_0030": "Select \"Contains\" in the second dropdown.",
    "text_0031": "In the third field, enter our email address ([Your Email Address]).",
    "text_0032": "In the \"Then move to folder\" dropdown, select \"Inbox.\"",
    "text_0033": "Click \"Save.\"",
    "text_0034": "For Outlook (formerly Hotmail):",
    "text_0035": "Log in to Outlook.",
    "text_0036": "Click the \"Settings\" gear icon in the upper-right corner.",
    "text_0037": "Choose \"View all Outlook settings\" at the bottom.",
    "text_0038": "Go to \"Mail\" > \"Junk email.\"",
    "text_0039": "Under \"Safe senders and domains,\" click \"Add.\"",
    "text_0040": "Enter our email address ([Your Email Address]).",
    "text_0041": "Click \"Add.\"",
    "text_0042": "Click \"Save\" to save your changes.",
    "text_0043": "For Apple Mail (macOS):",
    "text_0044": "Open Apple Mail.",
    "text_0045": "Go to \"Mail\" > \"Preferences.\"",
    "text_0046": "Click the \"Rules\" tab.",
    "text_0047": "Click \"Add Rule.\"",
    "text_0048": "In the \"Description\" field, give your rule a name (e.g., \"Whitelist [Your Company]\").",
    "text_0049": "Set the first condition to \"If any\" of the following conditions are met.",
    "text_0050": "Set the next condition to \"From\" and enter our email address ([Your Email Address]).",
    "text_0051": "Under \"Perform the following actions,\" select \"Move Message\" to mailbox \"Inbox.\"",
    "text_0052": "Click \"OK\" to save your rule.",
